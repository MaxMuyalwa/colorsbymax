{
  "name": "colorsbymax-mcp",
  "version": "0.1.3",
  "description": "MCP server for colorsbymax: lets AI agents set up the theme switcher, find and build themes, check contrast and finish a site's colours.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "colorsbymax",
    "theme",
    "colors",
    "palette",
    "wcag",
    "contrast",
    "ai-agents"
  ],
  "author": "Max Muyalwa (mrmaxdesigns)",
  "homepage": "https://github.com/MaxMuyalwa/colorsbymax/tree/main/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxMuyalwa/colorsbymax.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/MaxMuyalwa/colorsbymax/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "colorsbymax-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm --prefix .. run build:mcp",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run build && node test/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  }
