{
  "name": "colorsbymax",
  "version": "0.2.3",
  "description": "A live theme switcher for any website: site themes, 700+ palettes, for light/dark modes and WCAG contrast checks.",
  "keywords": [
    "theme",
    "theme-switcher",
    "colors",
    "colours",
    "palette",
    "dark-mode",
    "accessibility",
    "wcag",
    "contrast",
    "react",
    "tailwind"
  ],
  "author": "Max Muyalwa (mrmaxdesigns)",
  "homepage": "https://github.com/MaxMuyalwa/colorsbymax#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxMuyalwa/colorsbymax.git"
  },
  "bugs": {
    "url": "https://github.com/MaxMuyalwa/colorsbymax/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "typesVersions": {
    "*": {
      "pdf": [
        "./types/pdf.d.ts"
      ],
      "auto": [
        "./types/auto.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./types/auto.d.ts",
      "import": "./dist/auto.js",
      "default": "./dist/auto.js"
    },
    "./pdf": {
      "types": "./types/pdf.d.ts",
      "import": "./dist/pdf.js",
      "default": "./dist/pdf.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/auto.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "types/index.d.ts",
    "types/auto.d.ts",
    "types/pdf.d.ts",
    "src/tokens.css",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-css.mjs && vite build --config vite.lib.config.js",
    "typecheck": "tsc -p types && node scripts/check-types.mjs",
    "prepublishOnly": "npm run build && npm run typecheck",
    "build:demo": "vite build",
    "build:mcp": "vite build --config mcp/vite.config.js",
    "css": "node scripts/build-css.mjs",
    "icons": "node scripts/build-icons.mjs",
    "presets": "node scripts/generate-presets.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "pdfjs-dist": ">=4"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.48.0",
    "nice-color-palettes": "^4.0.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  },
  "license": "MIT"
}
