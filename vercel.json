{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:site",
  "outputDirectory": "demo/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/colorsbymax/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/colorsbymax/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/colorsbymax/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
